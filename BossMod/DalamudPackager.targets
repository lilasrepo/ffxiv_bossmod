<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- TC port (pinned): the DalamudPackager NuGet imports THIS file instead of its own default targets whenever
       it exists next to the csproj, so upstream's version (Debug PackageDev + Publish-only PackagePublish) leaves
       `dotnet build -c Release` with no manifest/zip in bin/Release. TC packages on Build, after the pack
       libraries have been built by BossMod.csproj's TcBuildPacks target. -->
  <ItemGroup>
    <_Publish Include="..\BossMod.Autorotation\BossMod.Autorotation.csproj" />
    <_Publish Include="..\BossMod.Modules\BossMod.Modules.csproj" />
    <_Publish Include="..\BossMod.Ultimate\BossMod.Ultimate.csproj" />
  </ItemGroup>

  <Target Name="PackageDev" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <DalamudPackager ProjectDir="$(ProjectDir)" OutputPath="$(OutputPath)" AssemblyName="$(AssemblyName)" MakeZip="false"/>
  </Target>

  <Target Name="PackageRelease" AfterTargets="TcBuildPacks" Condition="'$(Configuration)' == 'Release'">
    <DalamudPackager ProjectDir="$(ProjectDir)" OutputPath="$(OutputPath)" AssemblyName="$(AssemblyName)" MakeZip="true"/>
  </Target>

  <Target Name="PackagePublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <MSBuild Projects="@(_Publish)" BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="ChildLibraries" />
    </MSBuild>
    <Copy SourceFiles="@(ChildLibraries)" DestinationFolder="$(PublishDir)" />

    <DalamudPackager
      ProjectDir="$(ProjectDir)"
      OutputPath="$(PublishDir)"
      AssemblyName="$(AssemblyName)"
      MakeZip="true"/>
  </Target>
</Project>
